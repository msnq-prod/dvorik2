DVORIK_WEB_BIND_ADDRESS=127.0.0.1
DVORIK_WEB_PORT=58082
DVORIK_TIMEZONE=Asia/Vladivostok
DVORIK_RELEASE_VERSION=2026.08.18

# Generate unique values for production. Do not commit the real file.
DVORIK_INTERNAL_SECRET=replace-with-a-random-secret-at-least-32-bytes
DVORIK_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
TELEGRAM_BOT_TOKEN=replace-with-production-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
DVORIK_COOKIE_SAME_SITE=lax

# Single-server mode stores media in the persistent Docker volume and serves it
# from the app. Set this to 0 only after configuring an S3-compatible store.
DVORIK_LOCAL_MEDIA_ONLY=1

# Required only when DVORIK_LOCAL_MEDIA_ONLY=0.
DVORIK_OBJECT_STORAGE_ENDPOINT=https://storage.example.com
DVORIK_OBJECT_STORAGE_BUCKET=dvorik
DVORIK_OBJECT_STORAGE_PUBLIC_URL=https://cdn.example.com/dvorik
DVORIK_OBJECT_STORAGE_TOKEN=replace-with-object-storage-token
